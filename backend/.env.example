# CreativeAI Agent - User Authentication System

## Environment Variables

### Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=creativeai_auth
DB_USERNAME=creativeai
DB_PASSWORD=change_me_in_production

### Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1

### JWT Configuration
JWT_SECRET=base64:your-secret-key-here
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/app/storage/keys/private.key
JWT_PUBLIC_KEY_PATH=/app/storage/keys/public.key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

### Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="auth@creativeai.local"
MAIL_FROM_NAME="CreativeAI Agent"

### AWS / S3 (for profile photos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=creativeai-photos
AWS_URL=https://s3.amazonaws.com
AWS_ENDPOINT=

### Application
APP_NAME="CreativeAI Agent"
APP_ENV=local
APP_KEY=base64:SomeRandomStringWith32Characters
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

### Authentication
AUTH_GUARD=sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

### Rate Limiting
RATE_LIMIT_LOGIN=5/15m
RATE_LIMIT_API=60/1m
RATE_LIMIT_API_TOKEN=60/1m

### Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

### Testing (set automatically by .env.testing)
DB_DATABASE=creativeai_auth_test
REDIS_SESSION_DB=2
